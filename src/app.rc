#include <windows.h>
#include "resource.h"

IDI_APP ICON "icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,2,0
PRODUCTVERSION 1,1,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Taskbar Pulse"
            VALUE "FileDescription", "CPU, GPU, memory and network in the taskbar"
            VALUE "FileVersion", "1.1.2.0"
            VALUE "InternalName", "TaskbarPulse"
            VALUE "OriginalFilename", "TaskbarPulse.exe"
            VALUE "ProductName", "Taskbar Pulse"
            VALUE "ProductVersion", "1.1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
